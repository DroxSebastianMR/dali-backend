generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum BannerType {
  PROMOTION
  BUSINESS
  EVENT
  NEARBY
  RECOMMENDATION
}

enum BusinessStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}

enum BannerTargetType {
  BUSINESS
  CATEGORY
  PRODUCT
  PROMOTION
  SEARCH
  EXTERNAL_LINK
}

enum UpdateType {
  PATCH
  MINOR
  MAJOR
}

enum UserProvider {
  LOCAL
  FACEBOOK
  GOOGLE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model SystemConfig {
  id                  Int         @id @default(autoincrement())
  environment         String      @unique
  backend_name        String
  backend_version     String
  maintenance_enabled Boolean
  maintenance_message String?
  maintenance_end     DateTime?
  created_at          DateTime    @default(now())
  updated_at          DateTime    @updatedAt
  appConfigs          AppConfig[]
}

model AppConfig {
  id                    Int          @id @default(autoincrement())
  system_config_id      Int
  platform              String
  current_version       String
  min_supported_version String
  update_type           UpdateType
  update_message        String?
  store_url             String?
  active                Boolean      @default(true)
  created_at            DateTime     @default(now())
  updated_at            DateTime     @updatedAt
  systemConfig          SystemConfig @relation(fields: [system_config_id], references: [id])

  @@unique([system_config_id, platform])
}

model User {
  id Int @id @default(autoincrement())

  email         String  @unique
  password_hash String?

  provider    UserProvider @default(LOCAL)
  provider_id String?

  first_name   String
  last_name String
  phone String?
  photo_url String?

  email_verified    Boolean @default(false)
  telefono_verified Boolean @default(false)

  status UserStatus @default(ACTIVE)

  last_login_at DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  user_roles            UserRole[]
  refresh_tokens        RefreshToken[]
  user_devices          UserDevice[]
  notifications         Notification[]
  notification_prefs    NotificationPreference[]
  reset_password_tokens ResetPasswordToken[]

  home_banners HomeBanner[]
}

model UserRole {
  user_id Int
  role_id Int

  assigned_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
}

model Role {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  name        String?
  description String?

  created_at DateTime @default(now())

  user_roles UserRole[]
}

model RefreshToken {
  id Int @id @default(autoincrement())

  user_id Int
  user    User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  token_hash String @unique

  device_id   String?
  device_name String?

  is_revoked Boolean   @default(false)
  revoked_at DateTime?

  expires_at   DateTime
  last_used_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id])
}

model UserDevice {
  id      Int  @id @default(autoincrement())
  user_id Int
  user    User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  device_id    String
  device_token String  @unique
  platform     String
  model        String?

  last_used_at DateTime @default(now())

  @@index([user_id])
}

model Notification {
  id      Int  @id @default(autoincrement())
  user_id Int
  user    User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  business_id Int?
  title       String
  body        String
  type        String
  is_read     Boolean @default(false)
  metadata    Json?

  created_at DateTime @default(now())

  @@index([user_id])
}

model NotificationPreference {
  id      Int  @id @default(autoincrement())
  user_id Int
  user    User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  channel           String
  notification_type String
  enabled           Boolean @default(true)

  @@unique([user_id, channel, notification_type])
}

model ResetPasswordToken {
  id      Int @id @default(autoincrement())
  user_id Int

  token_hash String    @unique @db.VarChar(64)
  expires_at DateTime
  used_at    DateTime?
  request_ip String?   @db.VarChar(45)
  user_agent String?
  created_at DateTime  @default(now())
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}

model HomeBanner {
  id Int @id @default(autoincrement())

  title    String
  subtitle String?

  image_url        String
  background_color String?

  badge_text  String?
  badge_color String?

  type BannerType

  cta_text String?

  priority Int @default(0)

  starts_at  DateTime?
  expires_at DateTime?

  is_active Boolean @default(true)

  created_by Int?
  creator    User? @relation(fields: [created_by], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  targets   BannerTarget[]
  locations BannerLocation[]

  @@index([type])
  @@index([priority])
  @@index([is_active])
}

model BannerTarget {
  id Int @id @default(autoincrement())

  banner_id Int
  banner    HomeBanner @relation(fields: [banner_id], references: [id], onDelete: Cascade)

  target_type BannerTargetType

  business_id Int?
  business    Business? @relation(fields: [business_id], references: [id])

  category_id Int?
  category    ProductCategory? @relation(fields: [category_id], references: [id])

  product_id Int?
  product    Product? @relation(fields: [product_id], references: [id])

  search_query String?

  external_url String?

  created_at DateTime @default(now())

  @@index([banner_id])
}

model BannerLocation {
  id Int @id @default(autoincrement())

  banner_id Int
  banner    HomeBanner @relation(fields: [banner_id], references: [id], onDelete: Cascade)

  country  String?
  state    String?
  city     String?
  district String?

  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  radius_km Int?

  created_at DateTime @default(now())

  @@index([city])
  @@index([district])
}

model Business {
  id Int @id @default(autoincrement())

  owner_user_id Int?

  trade_name String
  legal_name     String?
  ruc              String?
  description      String?
  logo_url         String?

  status BusinessStatus @default(PENDING)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  banner_targets BannerTarget[]
}

model ProductCategory {
  id Int @id @default(autoincrement())

  name      String
  description String?

  parent_id Int?

  parent ProductCategory? @relation("CategoryParent", fields: [parent_id], references: [id])

  children ProductCategory[] @relation("CategoryParent")

  created_at DateTime @default(now())

  banner_targets BannerTarget[]

  products Product[]
}

model Product {
  id Int @id @default(autoincrement())

  name      String
  description String?

  barcode String? @unique

  brand         String?
  unit_of_measurement String?

  category_id Int?

  category ProductCategory? @relation(fields: [category_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  banner_targets BannerTarget[]
}
