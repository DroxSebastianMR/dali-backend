generator client {
  provider = "prisma-client-js"
}

generator dbml {
  provider = "prisma-dbml-generator"
  output   = "./dbml"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum BannerType {
  PROMOTION
  BUSINESS
  EVENT
  NEARBY
  RECOMMENDATION
}

enum BannerTargetType {
  BUSINESS
  CATEGORY
  PRODUCT
  PROMOTION
  SEARCH
  EXTERNAL_LINK
}

enum UpdateType {
  PATCH
  MINOR
  MAJOR
}

enum UserProvider {
  LOCAL
  FACEBOOK
  GOOGLE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum BusinessStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
  DELETED
}

enum InventoryMovementType {
  IN
  OUT
  ADJUSTMENT
  SALE
  RETURN
}

enum BusinessDocumentType {
  DNI
  RUC
  LICENSE
  SANITARY_PERMIT
  TAX_DOCUMENT
  BUSINESS_PHOTO
  LOGO
  OTHER
}

enum BusinessDocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

model SystemConfig {
  id                  Int         @id @default(autoincrement())
  environment         String      @unique
  backend_name        String
  backend_version     String
  maintenance_enabled Boolean
  maintenance_message String?
  maintenance_end     DateTime?
  created_at          DateTime    @default(now())
  updated_at          DateTime    @updatedAt
  appConfigs          AppConfig[]
}

model AppConfig {
  id                    Int          @id @default(autoincrement())
  system_config_id      Int
  platform              String
  current_version       String
  min_supported_version String
  update_type           UpdateType
  update_message        String?
  store_url             String?
  active                Boolean      @default(true)
  created_at            DateTime     @default(now())
  updated_at            DateTime     @updatedAt
  systemConfig          SystemConfig @relation(fields: [system_config_id], references: [id])

  @@unique([system_config_id, platform])
}

model User {
  id Int @id @default(autoincrement())

  email         String  @unique
  password_hash String?

  provider    UserProvider @default(LOCAL)
  provider_id String?

  first_name String
  last_name  String

  phone     String?
  photo_url String?

  email_verified    Boolean @default(false)
  telefono_verified Boolean @default(false)

  status UserStatus @default(ACTIVE)

  last_login_at DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  user_roles            UserRole[]
  refresh_tokens        RefreshToken[]
  user_devices          UserDevice[]
  notifications         Notification[]
  notification_prefs    NotificationPreference[]
  reset_password_tokens ResetPasswordToken[]

  home_banners HomeBanner[]

  owned_businesses Business[] @relation("BusinessOwner")
}

model UserRole {
  user_id Int
  role_id Int

  assigned_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
}

model Role {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  name        String?
  description String?

  created_at DateTime @default(now())

  user_roles UserRole[]
}

model RefreshToken {
  id Int @id @default(autoincrement())

  user_id Int
  user    User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  token_hash String @unique

  device_id   String?
  device_name String?

  is_revoked Boolean   @default(false)
  revoked_at DateTime?

  expires_at   DateTime
  last_used_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id])
}

model UserDevice {
  id      Int  @id @default(autoincrement())
  user_id Int
  user    User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  device_id    String
  device_token String  @unique
  platform     String
  model        String?

  last_used_at DateTime @default(now())

  @@index([user_id])
}

model Notification {
  id      Int  @id @default(autoincrement())
  user_id Int
  user    User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  business_id Int?
  title       String
  body        String
  type        String
  is_read     Boolean @default(false)
  metadata    Json?

  created_at DateTime @default(now())

  @@index([user_id])
}

model NotificationPreference {
  id      Int  @id @default(autoincrement())
  user_id Int
  user    User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  channel           String
  notification_type String
  enabled           Boolean @default(true)

  @@unique([user_id, channel, notification_type])
}

model ResetPasswordToken {
  id      Int @id @default(autoincrement())
  user_id Int

  token_hash String    @unique @db.VarChar(64)
  expires_at DateTime
  used_at    DateTime?
  request_ip String?   @db.VarChar(45)
  user_agent String?
  created_at DateTime  @default(now())
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}

model HomeBanner {
  id Int @id @default(autoincrement())

  title    String
  subtitle String?

  image_url        String
  background_color String?

  badge_text  String?
  badge_color String?

  type BannerType

  cta_text String?

  priority Int @default(0)

  starts_at  DateTime?
  expires_at DateTime?

  is_active Boolean @default(true)

  created_by Int?
  creator    User? @relation(fields: [created_by], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  targets   BannerTarget[]
  locations BannerLocation[]

  @@index([type])
  @@index([priority])
  @@index([is_active])
}

model BannerTarget {
  id Int @id @default(autoincrement())

  banner_id Int
  banner    HomeBanner @relation(fields: [banner_id], references: [id], onDelete: Cascade)

  target_type BannerTargetType

  business_id Int?
  business    Business? @relation(fields: [business_id], references: [id])

  category_id Int?
  category    ProductCategory? @relation(fields: [category_id], references: [id])

  product_id Int?
  product    Product? @relation(fields: [product_id], references: [id])

  search_query String?

  external_url String?

  created_at DateTime @default(now())

  @@index([banner_id])
}

model BannerLocation {
  id Int @id @default(autoincrement())

  banner_id Int
  banner    HomeBanner @relation(fields: [banner_id], references: [id], onDelete: Cascade)

  country  String?
  state    String?
  city     String?
  district String?

  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  radius_km Int?

  created_at DateTime @default(now())

  @@index([city])
  @@index([district])
}

model Business {
  id Int @id @default(autoincrement())

  owner_user_id Int?

  owner User? @relation("BusinessOwner", fields: [owner_user_id], references: [id])

  trade_name String
  legal_name String?

  ruc String? @unique

  description String?

  logo_url        String?
  cover_image_url String?

  email    String?
  phone    String?
  whatsapp String?

  website_url   String?
  instagram_url String?
  facebook_url  String?
  tiktok_url    String?

  status BusinessStatus @default(PENDING)

  is_verified Boolean   @default(false)
  verified_at DateTime?

  average_rating Decimal? @db.Decimal(3, 2)
  total_reviews  Int      @default(0)

  staff_names String[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  banner_targets BannerTarget[]

  locations          BusinessLocation[]
  business_documents BusinessDocument[]

  @@index([status])
  @@index([trade_name])
  @@index([ruc])
}

model BusinessLocation {
  id Int @id @default(autoincrement())

  business_id Int
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  name String?

  address String

  reference String?

  country  String?
  state    String?
  city     String?
  district String?

  latitude  Decimal @db.Decimal(9, 6)
  longitude Decimal @db.Decimal(9, 6)

  phone String?

  is_main Boolean @default(false)

  delivery_available Boolean @default(false)
  pickup_available   Boolean @default(true)

  is_active Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  business_hours BusinessHour[]
  special_hours  BusinessSpecialHour[]

  inventories Inventory[]

  @@index([business_id])
  @@index([city])
  @@index([district])
}

model BusinessHour {
  id Int @id @default(autoincrement())

  location_id Int

  day_of_week Int

  open_time  String
  close_time String

  is_closed Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  location BusinessLocation @relation(fields: [location_id], references: [id], onDelete: Cascade)

  @@unique([location_id, day_of_week])
  @@index([location_id])
}

model BusinessSpecialHour {
  id Int @id @default(autoincrement())

  location_id Int

  date DateTime @db.Date

  open_time  String?
  close_time String?

  is_closed Boolean @default(false)

  reason String?

  created_at DateTime @default(now())

  location BusinessLocation @relation(fields: [location_id], references: [id], onDelete: Cascade)

  @@unique([location_id, date])
  @@index([location_id])
}

model BusinessDocument {
  id Int @id @default(autoincrement())

  business_id Int

  type BusinessDocumentType

  file_url String

  file_name String?

  status BusinessDocumentStatus @default(PENDING)

  rejection_reason String?

  uploaded_by Int?

  reviewed_by Int?

  reviewed_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  business Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@index([business_id])
  @@index([type])
  @@index([status])
}

model ProductType {
  id Int @id @default(autoincrement())

  name        String  @unique
  description String?

  created_at DateTime @default(now())

  products Product[]
}

model ProductBrand {
  id Int @id @default(autoincrement())

  name String @unique

  logo_url String?

  description String?

  created_at DateTime @default(now())

  products Product[]
}

model ProductCategory {
  id Int @id @default(autoincrement())

  name String
  slug String @unique

  description String?

  image_url String?
  icon      String?

  is_active Boolean @default(true)

  sort_order Int @default(0)

  parent_id Int?

  parent ProductCategory? @relation("CategoryParent", fields: [parent_id], references: [id])

  children ProductCategory[] @relation("CategoryParent")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  products Product[]

  banner_targets BannerTarget[]

  @@index([slug])
  @@index([parent_id])
}

model Product {
  id Int @id @default(autoincrement())

  name String

  slug String @unique

  short_description String?
  description       String?

  sku     String? @unique
  barcode String? @unique

  type_id Int?
  type    ProductType? @relation(fields: [type_id], references: [id])

  category_id Int?
  category    ProductCategory? @relation(fields: [category_id], references: [id])

  brand_id Int?
  brand    ProductBrand? @relation(fields: [brand_id], references: [id])

  unit_of_measurement String?

  weight Decimal? @db.Decimal(10, 2)
  height Decimal? @db.Decimal(10, 2)
  width  Decimal? @db.Decimal(10, 2)
  length Decimal? @db.Decimal(10, 2)

  requires_shipping Boolean @default(true)

  is_active Boolean @default(true)

  seo_title       String?
  seo_description String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  images      ProductImage[]
  inventories Inventory[]
  prices      ProductPrice[]

  banner_targets BannerTarget[]

  @@index([name])
  @@index([slug])
  @@index([sku])
}

model ProductImage {
  id Int @id @default(autoincrement())

  product_id Int

  image_url String

  is_main Boolean @default(false)

  sort_order Int @default(0)

  created_at DateTime @default(now())

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
}

model Inventory {
  id Int @id @default(autoincrement())

  business_location_id Int
  product_id           Int

  stock Int @default(0)

  reserved_stock Int @default(0)

  min_stock Int @default(0)

  max_stock Int?

  cost_price Decimal? @db.Decimal(10, 2)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  business_location BusinessLocation @relation(fields: [business_location_id], references: [id], onDelete: Cascade)

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  movements InventoryMovement[]

  @@unique([business_location_id, product_id])
  @@index([product_id])
}

model ProductPrice {
  id Int @id @default(autoincrement())

  product_id Int

  name String?

  price Decimal @db.Decimal(10, 2)

  compare_at_price Decimal? @db.Decimal(10, 2)

  currency String @default("PEN")

  is_active Boolean @default(true)

  starts_at  DateTime?
  expires_at DateTime?

  created_at DateTime @default(now())

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
}

model InventoryMovement {
  id Int @id @default(autoincrement())

  inventory_id Int

  type InventoryMovementType

  quantity Int

  reason String?

  created_at DateTime @default(now())

  inventory Inventory @relation(fields: [inventory_id], references: [id], onDelete: Cascade)

  @@index([inventory_id])
}
